# Example environment configuration
# Copy this file to .env and fill in your keys.

# Pinecone API key for vector DB.
# This is the only key the project needs - embeddings run locally via Ollama.
PINECONE_API_KEY=your-pinecone-api-key

# Index name, used by both the upload script and the search queries.
# Vectors are 768-dimensional (nomic-embed-text), so the index must be
# created with dimension 768.
PINECONE_INDEX_NAME=your-index-name

# Optional. Where Ollama is listening; defaults to http://localhost:11434
# if unset. Set this if Ollama runs on another host or port.
# OLLAMA_HOST=http://localhost:11434
